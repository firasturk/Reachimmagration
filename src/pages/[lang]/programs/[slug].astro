---
// Program page. Country facts come from data/site.ts; the editorial copy (routes, amounts, process, FAQ) from data/programs/.
// Every amount is labelled with the date it was checked, and the page never promises approval.
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Consult from '../../../components/Consult.astro';
import ProgramCard from '../../../components/ProgramCard.astro';
import { ui, langs, type Lang } from '../../../i18n/ui';
import { pages } from '../../../i18n/pages';
import { programs, SITE } from '../../../data/site';
import { programContent } from '../../../data/programs';
export const getStaticPaths = () => langs.flatMap((lang) => programs.map((p) => ({ params: { lang, slug: p.slug }, props: { p } })));
const lang = Astro.params.lang as Lang; const { p } = Astro.props; const t = ui[lang]; const g = pages[lang].prog; const home = `/${lang}/`;
const c = programContent[p.slug]; const copy = c?.[lang];
const typeLabel = t.map.types[p.type];
const art = p.type === 'citizenship' ? '/images/sections/route-citizenship.webp' : '/images/sections/route-residency.webp';
const title = `${p[lang]} — ${typeLabel} | ${SITE.name}`;
const description = copy ? `${copy.tagline} ${copy.intro[0]}`.slice(0, 158) : (lang === 'ar' ? `${typeLabel} في ${p.ar} مع ريتش للهجرة. قيّم حالتك مجاناً وتحدّث إلى مستشار.` : `${typeLabel} in ${p.en} with Reach Immigration. Assess your case for free and talk to a consultant.`);
const related = programs.filter((o) => o.slug !== p.slug && o.region === p.region).slice(0, 4);
const also = related.length < 3 ? programs.filter((o) => o.slug !== p.slug && o.type === p.type && !related.includes(o)).slice(0, 4 - related.length) : [];
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [[t.programs.breadcrumbHome, home], [t.header.programs, `${home}programs/`], [p[lang], `${home}programs/${p.slug}/`]].map(([name, u], i) => ({ '@type': 'ListItem', position: i + 1, name, item: `${SITE.url}${u}` })) };
const faqLd = copy ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: copy.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) } : null;
const updated = c ? (lang === 'ar' ? c.updated.replace('September', 'سبتمبر') : c.updated) : '';
const routeHref = `${home}${p.type === 'citizenship' ? 'citizenship-by-investment' : 'residency-by-investment'}/`;
---
<Base lang={lang} title={title} description={description} path={`/programs/${p.slug}/`} jsonld={faqLd ? [crumbs, faqLd] : [crumbs]}>
  <section class="sec sec-page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={home}>{t.programs.breadcrumbHome}</a> / <a href={`${home}programs/`}>{t.header.programs}</a> / <a href={routeHref}>{typeLabel}</a> / <span aria-current="page">{p[lang]}</span></nav>
      <div class="prog-head">
        <SectionHead tag={`[ ${t.map.regions[p.region]} ]`} title={[p[lang]]} text={copy?.tagline ?? typeLabel} level="h1" />
        <img class="prog-art rv rv-art" src={art} alt="" width="800" height="800" decoding="async" />
      </div>
      <div class="prog-body">
        <div>
          <dl class="facts rv">
            {copy ? copy.facts.map((f, i) => <div class="rv-up" style={`--d:${i * 0.05}s`}><dt>{f.l}</dt><dd>{f.v}</dd></div>) : (
              <>
                <div class="rv-up"><dt>{t.passport.route}</dt><dd>{typeLabel}</dd></div>
                <div class="rv-up" style="--d:.06s"><dt>{t.passport.region}</dt><dd>{t.map.regions[p.region]}</dd></div>
              </>
            )}
            <div class="rv-up" style="--d:.4s"><dt>{t.passport.agent}</dt><dd>{p.licensed ? <a href={p.licensed} rel="noopener" target="_blank">{t.passport.agentYes}</a> : t.passport.agentNo}</dd></div>
          </dl>
          {c && <p class="prog-updated">{g.updated} {updated}. {g.disclaimer}</p>}
        </div>
        <div class="prose rv rv-up" style="--d:.15s">
          <div class="prog-intro">{copy ? copy.intro.map((para) => <p>{para}</p>) : <p data-split>{t.programs.soon}</p>}</div>
          {p.licensed && <p class="prog-note">{g.licensedNote} <a href={p.licensed} rel="noopener" target="_blank">{g.verify}</a></p>}
          <p><a class="btn btn-solid" href="#consult" data-assess={p.slug}>{t.map.assess}</a> <a class="btn btn-ghost" href={routeHref}>{typeLabel}</a></p>
        </div>
      </div>
    </div>
  </section>

  {copy && (
    <>
      <section class="sec tone-mist">
        <div class="container two-col">
          <div class="sec-head rv"><h2 class="sec-title sm rv-lines"><span class="mask"><span>{g.why}</span></span></h2></div>
          <ol class="why-list rv">{copy.why.map((w, i) => <li class="rv-up" style={`--d:${0.1 + i * 0.08}s`}><span>{String(i + 1).padStart(2, '0')}</span><h3>{w.t}</h3><p>{w.p}</p></li>)}</ol>
        </div>
      </section>

      <section class="sec tone-ivory">
        <div class="container">
          <div class="sec-head rv"><h2 class="sec-title sm rv-lines"><span class="mask"><span>{g.options}</span></span></h2></div>
          <div class="opt-cards rv">
            {copy.options.map((o, i) => (
              <article class="opt-card rv-up" style={`--d:${0.1 + i * 0.08}s`}>
                {o.from && <p class="from"><small>{g.from}</small>{o.from}</p>}
                <h3>{o.t}</h3>
                <p>{o.p}</p>
              </article>
            ))}
          </div>
          <p class="prog-updated">{g.updated} {updated}. {g.disclaimer}</p>
        </div>
      </section>

      <section class="sec">
        <div class="container two-col">
          <div>
            <div class="sec-head rv"><h2 class="sec-title sm rv-lines"><span class="mask"><span>{g.process}</span></span></h2></div>
            <div class="family-box rv rv-up" style="--d:.2s"><h3>{g.family}</h3><p>{copy.family}</p></div>
          </div>
          <ol class="steps rv">{copy.process.map((s, i) => <li class="rv-up" style={`--d:${0.1 + i * 0.07}s`}>{s}</li>)}</ol>
        </div>
      </section>

      <section class="sec tone-mist">
        <div class="container two-col">
          <div class="sec-head rv"><h2 class="sec-title sm rv-lines"><span class="mask"><span>{g.faq}</span></span></h2><p class="sec-text">{g.talk}: <a href="#consult" data-assess={p.slug}>{t.map.assess}</a></p></div>
          <div class="faq rv rv-up">{copy.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
        </div>
      </section>
    </>
  )}

  {(related.length > 0 || also.length > 0) && (
    <section class="sec">
      <div class="container">
        <div class="sec-head rv"><h2 class="sec-title sm rv-lines"><span class="mask"><span>{related.length > 0 ? `${g.related} ${t.map.regions[p.region]}` : g.otherRoute}</span></span></h2></div>
        <ul class="prog-grid compact rv" role="list">{[...related, ...also].map((o, i) => <ProgramCard p={o} lang={lang} i={i} />)}</ul>
        <p class="cta-row"><a class="btn btn-ghost" href={`${home}programs/`}>{t.programs.back}</a></p>
      </div>
    </section>
  )}
  <Consult lang={lang} />
</Base>
