---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Licenses from '../../../components/Licenses.astro';
import Consult from '../../../components/Consult.astro';
import { ui, langs, type Lang } from '../../../i18n/ui';
import { pages } from '../../../i18n/pages';
import { branches, SITE } from '../../../data/site';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang; const t = ui[lang]; const a = pages[lang].about; const home = `/${lang}/`;
const countries = [...new Set(branches.map((b) => b.country))];
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [[t.programs.breadcrumbHome, home], [t.footer.about_l, `${home}about-us/`]].map(([name, u], i) => ({ '@type': 'ListItem', position: i + 1, name, item: `${SITE.url}${u}` })) };
---
<Base lang={lang} title={a.meta} description={a.desc} path="/about-us/" jsonld={[crumbs]}>
  <section class="sec sec-page-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={home}>{t.programs.breadcrumbHome}</a> / <span aria-current="page">{t.footer.about_l}</span></nav>
      <SectionHead tag={a.tag} title={a.title} text={a.text} level="h1" />
      <div class="stat-grid rv">{a.stats.map((s, i) => <div class="stat rv-up" style={`--d:${0.1 + i * 0.06}s`}><b>{s.n}</b><span>{s.l}</span></div>)}</div>
    </div>
  </section>
  <section class="sec tone-mist">
    <div class="container two-col">
      <SectionHead tag={a.storyTag} title={a.storyTitle} motion="slide" />
      <div class="prog-intro rv rv-up">{a.story.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>
  <section class="sec">
    <div class="container two-col">
      <SectionHead tag={a.valuesTag} title={a.valuesTitle} />
      <ol class="why-list rv">{a.values.map((v, i) => <li class="rv-up" style={`--d:${0.1 + i * 0.08}s`}><span>{String(i + 1).padStart(2, '0')}</span><h3>{v.t}</h3><p>{v.p}</p></li>)}</ol>
    </div>
  </section>
  <section class="sec tone-mist">
    <div class="container two-col">
      <SectionHead tag={a.stepsTag} title={a.stepsTitle} motion="slide" />
      <ol class="steps named rv">{a.steps.map((s, i) => <li class="rv-up" style={`--d:${0.1 + i * 0.08}s`}><h3>{s.t}</h3><p>{s.p}</p></li>)}</ol>
    </div>
  </section>
  <section class="sec">
    <div class="container">
      <SectionHead tag={a.branchesTag} title={a.branchesTitle} text={a.branchesText} />
      <div class="branch-grid rv">
        {countries.map((c, i) => <div class:list={['branch rv-up', { hq: i === 0 }]} style={`--d:${0.1 + i * 0.05}s`}><b>{branches.find((b) => b.country === c)![lang].split(' — ')[0]}</b><span>{branches.filter((b) => b.country === c).map((b) => b[lang].split(' — ')[1] ?? b[lang]).join(' · ')}</span></div>)}
      </div>
      <p class="cta-row"><a class="btn btn-solid" href={`${home}contact-us/`}>{a.contactCta}</a><a class="btn btn-ghost" href="#licenses">{a.licensesCta}</a></p>
    </div>
  </section>
  <Licenses lang={lang} />
  <Consult lang={lang} />
</Base>
