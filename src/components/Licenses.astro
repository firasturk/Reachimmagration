---
import SectionHead from './SectionHead.astro';
import { ui, type Lang } from '../i18n/ui';
import { programs } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props; const t = ui[lang].licenses;
const licensed = programs.filter((p) => p.licensed);
---
<section class="sec sec-licenses tone-ivory" id="licenses">
  <div class="container">
    <SectionHead tag={t.tag} title={t.title} text={t.text} />
    <ul class="lic-grid rv" role="list">
      {licensed.map((p, i) => <li class="rv-up" style={`--d:${i * 0.06}s`}><a href={p.licensed} rel="noopener" target="_blank"><h3>{p[lang]}</h3><span class="link-arrow">{t.verify}</span></a></li>)}
    </ul>
  </div>
</section>
