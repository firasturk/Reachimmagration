          <div class="wrap a" style="left:-204.65px;top:-175.56px;width:506.44px;height:506.44px;--from:translateY(-373px) rotate(48.3deg)"><div class="im" style="width:400.84px;height:400.84px;transform:rotate(-18.3deg)"><img loading="lazy" decoding="async" src="/images/hero/card-s1.webp" alt=""></div></div>
        </div>
        <div class="ink a" style="left:328.5px;top:0;height:281px;--from:translateY(513px)">
          <p class="num a" style="left:27.46px;top:207.12px;--from:translateY(-203px)">5.0</p>
          <p class="lbl a" style="left:30px;top:242.92px;--from:translateY(-173px)">{h.stats.rating}</p>
        </div>
      </div>
    </div>

    <!-- SCENE 2: in at 5.5s → out at 9.25s -->
    <div class="grp" id="s2" data-state="pre">
      <h2 class="h2">
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-110px"})`}>{h.h2d[0]}</span></span>
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-290px"})`}>{h.h2d[1]}</span></span>
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-270px"})`}>{h.h2d[2]}</span></span>
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-350px"})`}>{h.h2d[3]}</span></span>
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-400px"})`}>{h.h2d[4]}</span></span>
      </h2>
      <div class="mask" style="left:1183px;top:191px;width:232px;height:80px"><p class="title a" style="width:232px;--from:translateY(-100%)">{h.title2}</p></div>
      <div class="mask" style="left:1183px;top:297px;width:232px;height:104px"><p class="body20 a" style="width:232px;--from:translateY(110px)">{h.body2}</p></div>

      <div style="left:396.19px;top:584.85px;width:647.23px;height:211.15px">
        <!-- 1b — glass, lands tilted. image only scales (1.858→1) and turns 15.5°, centre fixed -->
        <div class="card glass a" style="left:16.8px;top:19.15px;--rest:rotate(15deg);--from:translateY(350px)">
          <div class="wrap" style="left:3.01px;top:-111.01px;width:331.44px;height:331.44px"><div class="im" style="width:269.35px;height:269.35px;transform:rotate(-164.53deg) scaleY(-1);filter:blur(40px);opacity:.5"><img loading="lazy" decoding="async" src="/images/hero/card-s2-left.webp" alt=""></div></div>
          <div class="wrap a" style="left:10.08px;top:-123.25px;width:331.44px;height:331.44px;--from:scale(1.858) rotate(-15.47deg)"><div class="im" style="width:269.35px;height:269.35px;transform:rotate(-164.53deg) scaleY(-1)"><img loading="lazy" decoding="async" src="/images/hero/card-s2-left.webp" alt=""></div></div>
        </div>
        <div class="ink a" style="left:16.8px;top:19.15px;--rest:rotate(15deg);--from:translateY(350px)">
          <p class="num a" style="left:20.49px;top:76px;--from:translateY(-20px)">17</p>
          <p class="lbl a" style="left:23.03px;top:111.8px;--from:translateY(-10px)">{h.stats.branches}</p>
        </div>
        <!-- 1ms — dark -->
        <div class="card dark a" style="left:239.8px;top:59.15px;--from:translateY(190px)">
          <div class="wrap" style="left:-82.94px;top:-196.85px;width:531.01px;height:531.01px"><div class="im" style="width:400.84px;height:400.84px;transform:rotate(-155.49deg) scaleY(-1);filter:blur(24.75px);opacity:.6"><img loading="lazy" decoding="async" src="/images/hero/card-s2-mid.webp" alt=""></div></div>
          <div class="wrap a" style="left:-11.9px;top:-139.63px;width:359.8px;height:359.8px;--from:scale(1.573) rotate(-15deg)"><div class="im" style="width:293.78px;height:293.78px;transform:rotate(-165deg) scaleY(-1)"><img loading="lazy" decoding="async" src="/images/hero/card-s2-mid.webp" alt=""></div></div>
          <p class="num soft-ink a" style="left:20.49px;top:76px;--from:translateY(-20px)">ISO</p>
          <p class="lbl soft-ink a" style="left:23.03px;top:111.8px;--from:translateY(-10px)">{h.stats.iso}</p>
        </div>
        <!-- 92% — glass, lands tilted. image scales 1.168→1, turns 16.4°, shifts (-24, +35) -->
        <div class="card glass a" style="left:462.4px;top:19.15px;--rest:rotate(-15deg);--from:translateY(350px)">
          <div class="wrap a" style="left:-61.1px;top:-249.27px;width:531.09px;height:531.09px;--from:translate(-24.28px,35.47px) scale(1.168) rotate(-16.4deg)"><div class="im" style="width:427.74px;height:427.74px;transform:rotate(16.4deg) scaleY(-1)"><img loading="lazy" decoding="async" src="/images/hero/card-s2-right.webp" alt=""></div></div>
        </div>
        <div class="ink a" style="left:462.4px;top:19.15px;--rest:rotate(-15deg);--from:translateY(350px)">
          <p class="num a" style="left:20.49px;top:76px;--from:translateY(-20px)">6</p>
          <p class="lbl a" style="left:23.03px;top:111.8px;--from:translateY(-10px)">{h.stats.licenses}</p>
        </div>
      </div>
    </div>

    <!-- SCENE 3: in at 11s, stays -->
    <div class="grp" id="s3" data-state="pre">
      <div style="left:30.75px;top:218px;width:1378.5px;height:549px">
        <div class="tcard glass a" data-picker role="button" tabindex="0" style="left:0;top:0;--from:translateY(1330px)">
          <h3 class="a" style="--from:translateY(90px)">{h.c1t}<svg class="dots" viewBox="0 0 5.8 9.2" aria-hidden="true"><rect width="2.4" height="2.4"/><rect y="6.8" width="2.4" height="2.4"/><rect x="3.4" y="3.4" width="2.4" height="2.4"/></svg></h3>
          <p class="a" style="--from:translateY(190px)">{h.c1p}</p>
        </div>
        <div class="tcard glass a" style="left:1153.5px;top:1px;--from:translateY(1329px)">
          <h3 class="a" style="--from:translateY(90px)">{h.c3t}</h3>
          <p class="a" style="--from:translateY(190px)">{h.c3p}</p>
        </div>
        <div class="vcard a" style="left:214.62px;top:259px;--from:translateY(781px)">
          <div class="media a" style="left:0;top:0;width:225px;height:199px;--from:scale(1.826)"><video class="lp" data-v="loop1" data-src="/video/family-walk.mp4" poster="/images/hero/family-walk-poster.jpg" loop muted playsinline preload="metadata"></video></div>
        </div>
        <div class="vcard a" style="left:938.88px;top:259px;--from:translateY(781px)">
          <div class="media a" style="left:0;top:0;width:225px;height:199px;transform-origin:50% 47.72%;--from:scale(1.703)"><video class="lp" data-v="loop2" data-src="/video/family-pool.mp4" poster="/images/hero/family-pool-poster.jpg" loop muted playsinline preload="metadata"></video></div>
        </div>
        <div class="tcard glass a" style="left:576.75px;top:350px;--from:translateY(440px)">
          <h3 class="a" style="--from:translateY(90px)">{h.c2t}</h3>
          <p class="a" style="--from:translateY(180px)">{h.c2p}</p>
        </div>
      </div>
    </div>
  </div>
  <!-- MOBILE STAGE — 390×780 design, scaled to the hero width. Same scenes, same timeline, same .a animation system.
       The theme has no mobile screens in Figma: this layout is Reach-specific. -->
  <div class="mstage" id="mstage">
    <div class="m-bg" id="mBgSlot"></div>
    <div class="m-topfade"></div>
    <div class="m-fade"></div>

    <div class="grp" id="m-nav" data-state="pre">
      <div class="m-logo a" style="--from:translateY(-70px)" aria-label="Reach Immigration"><b>REACH</b><i>Immigration</i></div>
      <a href="#consult" data-picker class="m-cta-sm rim a" style="--from:translateY(-70px);--d:.06s"><span>{h.navCta}</span><svg class="dots" viewBox="0 0 5.8 9.2" aria-hidden="true"><rect width="2.4" height="2.4"/><rect y="6.8" width="2.4" height="2.4"/><rect x="3.4" y="3.4" width="2.4" height="2.4"/></svg></a>
      <button type="button" class="m-menu rim a" id="mMenuBtn" aria-expanded="false" aria-controls="mMenu" aria-label={h.menu} style="--from:translateY(-70px);--d:.12s"><i></i><i></i></button>
      <nav class="m-menu-panel" id="mMenu" hidden>{links.map((l,i)=><a href={l}>{h.nav[i]}</a>)}<a href={altHref} lang={altLang} hreflang={altLang}>{h.langSwitch}</a></nav>
    </div>

    <div class="grp" id="m-s1" data-state="pre">
      <p class="m-h1" aria-hidden="true">
        <span class="mask"><span class="a" style="--from:translateY(-105%)">{h.h1[0]}</span></span>
        <span class="mask"><span class="a" style="--from:translateY(-105%);--d:.06s">{h.h1[1]}</span></span>
        <span class="mask"><span class="a" style="--from:translateY(-105%);--d:.12s">{h.h1[2]}</span></span>
      </p>
      <div class="mask m-sub-mask"><p class="m-sub a" style="--from:translateY(-110%);--d:.2s;--dx:.1s">{h.sub}</p></div>
      <a href="#consult" data-picker class="m-cta a" style="--from:translateY(30px);--from-op:0;--d:.25s;--dx:.1s"><span>{h.cta}</span><svg class="dots" viewBox="0 0 5.8 9.2" aria-hidden="true"><rect width="2.4" height="2.4"/><rect y="6.8" width="2.4" height="2.4"/><rect x="3.4" y="3.4" width="2.4" height="2.4"/></svg></a>
      <div class="m-row" tabindex="0" aria-label={h.rowAria}>
        <div class="m-card m-vid a" style="--from:translateY(150px);--d:.3s;--dx:.0s"><video class="lp" data-v="loop1" data-src="/video/family-walk.mp4" poster="/images/hero/family-walk-poster.jpg" loop muted playsinline preload="metadata"></video></div>
        <div class="m-card glass a" style="--from:translateY(150px);--d:.38s;--dx:.05s"><p class="m-num">25+</p><p class="m-lbl">{h.stats.years}</p></div>
        <div class="m-card dark a" style="--from:translateY(150px);--d:.46s;--dx:.1s"><img class="m-ci" src="/images/hero/card-s1.webp" alt=""><p class="m-num">18+</p><p class="m-lbl">{h.stats.countries}</p></div>
        <div class="m-card glass a" style="--from:translateY(150px);--d:.54s;--dx:.15s"><img class="m-ci" src="/images/hero/card-s1.webp" alt=""><p class="m-num">5.0</p><p class="m-lbl">{h.stats.rating}</p></div>
      </div>
    </div>

    <div class="grp" id="m-s2" data-state="pre">
      <h2 class="m-h2">
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-105%"})`}>{h.h2m[0]}</span></span>
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-105%"});--d:.06s`}>{h.h2m[1]}</span></span>
        <span class="mask"><span class="a" style={`--from:translateX(${rtl?"105%":"-105%"});--d:.12s`}>{h.h2m[2]}</span></span>
      </h2>
      <div class="mask m-title-mask"><p class="m-title a" style="--from:translateY(-110%);--d:.18s">{h.title2}</p></div>
      <div class="mask m-body-mask"><p class="m-body a" style="--from:translateY(84px);--d:.24s">{h.body2}</p></div>
      <div class="m-row" tabindex="0" aria-label={h.rowAria}>
        <div class="m-card glass a" style="--from:translateY(150px);--d:.3s"><img class="m-ci" src="/images/hero/card-s2-left.webp" alt=""><p class="m-num">17</p><p class="m-lbl">{h.stats.branches}</p></div>
        <div class="m-card dark a" style="--from:translateY(150px);--d:.38s;--dx:.05s"><img class="m-ci" src="/images/hero/card-s2-mid.webp" alt=""><p class="m-num">ISO</p><p class="m-lbl">{h.stats.iso}</p></div>
        <div class="m-card glass a" style="--from:translateY(150px);--d:.46s;--dx:.1s"><img class="m-ci" src="/images/hero/card-s2-right.webp" alt=""><p class="m-num">6</p><p class="m-lbl">{h.stats.licenses}</p></div>
      </div>
    </div>

    <div class="grp" id="m-s3" data-state="pre">
      <div class="m-thumbs">
        <div class="m-thumb a" style="--from:scale(.55);--from-op:0"><video class="lp" data-v="loop1" data-src="/video/family-walk.mp4" poster="/images/hero/family-walk-poster.jpg" loop muted playsinline preload="metadata"></video></div>
        <div class="m-thumb a" style="--from:scale(.55);--from-op:0;--d:.08s"><video class="lp" data-v="loop2" data-src="/video/family-pool.mp4" poster="/images/hero/family-pool-poster.jpg" loop muted playsinline preload="metadata"></video></div>
      </div>
      <div class="m-stack">
        <div class="m-tcard glass a" data-picker role="button" tabindex="0" style="--from:translateY(70px);--from-op:0;--d:.12s"><h3>{h.c1t}<svg class="dots" viewBox="0 0 5.8 9.2" aria-hidden="true"><rect width="2.4" height="2.4"/><rect y="6.8" width="2.4" height="2.4"/><rect x="3.4" y="3.4" width="2.4" height="2.4"/></svg></h3><p>{h.c1p}</p></div>
        <div class="m-tcard glass a" style="--from:translateY(70px);--from-op:0;--d:.2s"><h3>{h.c2t}</h3><p>{h.c2p}</p></div>
        <div class="m-tcard glass a" style="--from:translateY(70px);--from-op:0;--d:.28s"><h3>{h.c3t}</h3><p>{h.c3p}</p></div>
      </div>
    </div>
  </div>
</section>
